# Configuracion local (credenciales, overrides). Ver config.example/
/config/
/public/uploads/
/docs/
/storage/sgd_imports/
/storage/sihos_reportes/
/storage/backups/*
!/storage/backups/.gitkeep
/storage/locks/*.lock

# Codigo del sistema externo SIHOS (otro proyecto, ~794 MB, puede contener
# datos clinicos): vive junto al repo por conveniencia de despliegue pero
# nunca debe versionarse aqui.
/sihos/

# Logs de diagnostico en runtime
/storage/*.log
/storage/*.txt

# Entorno virtual Python local para edge-tts (audio de referencia de
# Academic con texto a voz) — se recrea con:
#   python3 -m venv scripts/.tts-venv && scripts/.tts-venv/bin/pip install edge-tts
/scripts/.tts-venv/
