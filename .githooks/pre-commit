#!/usr/bin/env bash
#
# Pre-commit local de SAVID: dos chequeos automáticos que no dependen de que
# nadie se acuerde de correrlos a mano.
#
#   1) Tamaño del commit: avisa/bloquea si se acumulan demasiadas líneas de
#      cambio en un solo commit (micro-commits en vez de uno gigante al
#      final, para que cada commit sea revisable de un vistazo).
#   2) Linter de arquitectura: bloquea SQL nuevo (->prepare/->query/new PDO)
#      o instanciación directa de un *Repository dentro de app/controllers.
#      Solo revisa las LÍNEAS NUEVAS que agrega este commit (el diff), no el
#      archivo completo — el proyecto ya tiene SQL viejo en varios
#      controllers (deuda anterior a este hook) y no queremos bloquear
#      trabajo futuro por eso; solo evitamos que se agregue MÁS.
#   3) Aislamiento por tenant: avisa si una consulta SQL NUEVA en
#      app/models/*Repository.php toca una tabla que tiene columna
#      empresa_id en el esquema REAL (scripts/dump_tenant_tables.php contra
#      la BD; cae a leer database/migrations/*.sql si no hay BD disponible)
#      sin que 'empresa_id' aparezca en el mismo bloque de líneas agregadas.
#      Es una señal, no una prueba: puede haber falsos positivos (ej. un
#      JOIN que ya trae el filtro desde otra tabla) — por eso tiene escape
#      explícito, a diferencia del chequeo 2. Complementa a
#      TenantIsolationGuard (app/services/), que hace el mismo chequeo pero
#      en cada petición real, no solo en el diff de un commit.
#   4) CSP: bloquea si el commit agrega un <script> inline nuevo en
#      app/views sin nonce="<?= CspNonceService::value() ?>" — sin eso el
#      navegador simplemente no lo ejecuta (ver README.md, sección CSP).
#
# Ver README.md, sección "Chequeos automáticos antes de cada commit".

set -euo pipefail

LIMITE_LINEAS="${SAVID_LIMITE_LINEAS_COMMIT:-200}"
FALLO=0

# ---------------------------------------------------------------------------
# 1) Tamaño del commit
# ---------------------------------------------------------------------------
TOTAL_LINEAS=$(git diff --cached --numstat -- . ':!database/migrations' ':!vendor' \
    | awk '{ if ($1 != "-") add+=$1; if ($2 != "-") del+=$2 } END { print add+del }')
TOTAL_LINEAS="${TOTAL_LINEAS:-0}"

if [ "$TOTAL_LINEAS" -gt "$LIMITE_LINEAS" ]; then
    if [ "${SAVID_PERMITIR_COMMIT_GRANDE:-0}" = "1" ]; then
        echo "⚠️  Commit de ${TOTAL_LINEAS} líneas (límite sugerido: ${LIMITE_LINEAS}) — permitido explícitamente vía SAVID_PERMITIR_COMMIT_GRANDE=1."
    else
        echo "❌ Este commit cambia ${TOTAL_LINEAS} líneas (límite: ${LIMITE_LINEAS}, sin contar database/migrations ni vendor)."
        echo "   Divídelo en commits más pequeños y enfocados en un solo cambio lógico."
        echo "   Si es un caso legítimo de un solo cambio grande e indivisible, repite el commit con:"
        echo "     SAVID_PERMITIR_COMMIT_GRANDE=1 git commit ..."
        FALLO=1
    fi
fi

# ---------------------------------------------------------------------------
# 2) Linter de arquitectura: SQL o Repository nuevos en app/controllers
# ---------------------------------------------------------------------------
ARCHIVOS_CONTROLLER=$(git diff --cached --name-only --diff-filter=ACM -- 'app/controllers/*.php' || true)

if [ -n "$ARCHIVOS_CONTROLLER" ]; then
    while IFS= read -r archivo; do
        [ -z "$archivo" ] && continue

        # awk en vez de "grep" encadenado: dentro de sesiones de Claude Code,
        # "grep" puede estar redefinido como función de shell hacia ugrep con
        # flags que rompen este patrón (-G fuerza regex básico) y fallan en
        # silencio — awk no sufre ese problema y su ERE es consistente.
        LINEAS_MALAS=$(git diff --cached -- "$archivo" | awk '
            /^\+\+\+/ { next }
            /^\+/ && /(->prepare\(|->query\(|new PDO\(|new [A-Za-z_]+Repository\()/ { print }
        ')

        if [ -n "$LINEAS_MALAS" ]; then
            echo "❌ $archivo agrega SQL o uso directo de Repository — eso va en un Service, no en el Controller (ver CLAUDE.md):"
            echo "$LINEAS_MALAS" | sed 's/^/     /'
            FALLO=1
        fi
    done <<< "$ARCHIVOS_CONTROLLER"
fi

# ---------------------------------------------------------------------------
# 3) Aislamiento por tenant: SQL nuevo en app/models contra una tabla
#    multi-tenant (tiene columna empresa_id) sin 'empresa_id' en el mismo
#    bloque de líneas agregadas.
# ---------------------------------------------------------------------------
# Preferimos el esquema REAL (vía scripts/dump_tenant_tables.php, misma
# fuente que usa TenantIsolationGuard en runtime): algunos ALTER TABLE que
# agregaron empresa_id se corrieron sin dejar migración rastreable, así que
# el parseo de archivos de abajo por sí solo se queda corto (confirmado:
# falta pago, permiso, rol_permiso, sede, sihos_salario_minimo, suscripcion,
# usuario_empresa — created_at). Si no hay BD disponible (máquina sin
# config/.env, o php no está en PATH), cae al parseo de archivos.
TABLAS_MULTITENANT=$(php scripts/dump_tenant_tables.php 2>/dev/null | sort -u)

if [ -z "$TABLAS_MULTITENANT" ]; then
    echo "ℹ️  No se pudo leer el esquema real (sin BD/config/.env) — usando database/migrations/*.sql como respaldo para el chequeo de aislamiento por tenant (puede faltar alguna tabla cuyo ALTER no esté en una migración)."
    TABLAS_MULTITENANT=$(for f in database/migrations/*.sql; do
        awk '
            /CREATE TABLE/ {
                tbl = $0
                gsub(/.*CREATE TABLE( IF NOT EXISTS)?[ \t]*`/, "", tbl)
                gsub(/`.*/, "", tbl)
                has_emp = 0
                next
            }
            /`empresa_id`/ { if (tbl != "") has_emp = 1 }
            /^\);/ || /^\) ENGINE/ {
                if (tbl != "" && has_emp == 1) print tbl
                tbl = ""
            }
        ' "$f"
    done | sort -u)
fi

ARCHIVOS_MODELS=$(git diff --cached --name-only --diff-filter=ACM -- 'app/models/*.php' || true)

if [ -n "$ARCHIVOS_MODELS" ] && [ -n "$TABLAS_MULTITENANT" ]; then
    PATRON_TABLAS=$(echo "$TABLAS_MULTITENANT" | paste -sd'|')
    AVISO_TENANT=0

    while IFS= read -r archivo; do
        [ -z "$archivo" ] && continue

        AVISOS=$(git diff --cached -- "$archivo" | awk -v tablas="$PATRON_TABLAS" '
            function revisar() {
                if (bloque != "" \
                    && bloque ~ ("(FROM|INTO|UPDATE|JOIN)[ \t]+`?(" tablas ")`?") \
                    && bloque !~ /empresa_id/) {
                    print bloque
                }
                bloque = ""
            }
            /^\+\+\+/ { next }
            /^\+/ { bloque = bloque "\n" substr($0, 2); next }
            { revisar() }
            END { revisar() }
        ')

        if [ -n "$AVISOS" ]; then
            echo "⚠️  $archivo agrega una consulta contra una tabla multi-tenant (con empresa_id en su esquema) sin filtrar por empresa_id en las líneas agregadas:"
            echo "$AVISOS" | sed 's/^/     /'
            AVISO_TENANT=1
        fi
    done <<< "$ARCHIVOS_MODELS"

    if [ "$AVISO_TENANT" -eq 1 ]; then
        if [ "${SAVID_PERMITIR_QUERY_SIN_EMPRESA:-0}" = "1" ]; then
            echo "⚠️  Aviso de aislamiento por tenant ignorado explícitamente vía SAVID_PERMITIR_QUERY_SIN_EMPRESA=1."
        else
            echo ""
            echo "   Si es legítimo (ej. el filtro ya llega por un JOIN, o es una operación de superadmin intencional), repite el commit con:"
            echo "     SAVID_PERMITIR_QUERY_SIN_EMPRESA=1 git commit ..."
            FALLO=1
        fi
    fi
fi

# ---------------------------------------------------------------------------
# 4) CSP: <script> inline nuevo en app/views sin nonce
# ---------------------------------------------------------------------------
ARCHIVOS_VISTAS=$(git diff --cached --name-only --diff-filter=ACM -- 'app/views' | command grep '\.php$' || true)

if [ -n "$ARCHIVOS_VISTAS" ]; then
    while IFS= read -r archivo; do
        [ -z "$archivo" ] && continue

        LINEAS_SIN_NONCE=$(git diff --cached -- "$archivo" | awk '
            /^\+\+\+/ { next }
            /^\+/ && /<script/ && !/src=/ && !/nonce=/ { print }
        ')

        if [ -n "$LINEAS_SIN_NONCE" ]; then
            echo "❌ $archivo agrega un <script> inline sin nonce (rompe la CSP, ver README.md sección CSP):"
            echo "$LINEAS_SIN_NONCE" | sed 's/^/     /'
            echo "   Agrega: nonce=\"<?= CspNonceService::value() ?>\""
            FALLO=1
        fi
    done <<< "$ARCHIVOS_VISTAS"
fi

if [ "$FALLO" -eq 1 ]; then
    echo ""
    echo "Commit bloqueado por el pre-commit de SAVID (.githooks/pre-commit)."
    exit 1
fi

exit 0
