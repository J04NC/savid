# Copiar a config/.env o a la raiz del proyecto como .env
# La carpeta /config/ esta ignorada por git.

DB_HOST=localhost
DB_DATABASE=savid
DB_USERNAME=root
DB_PASSWORD=

DB_CHARSET=utf8mb4
APP_TIMEZONE=America/Bogota

# Segundos que MySQL mantiene abierta una conexión web inactiva (solo peticiones
# web; la CLI conserva el valor del servidor). Evita que un worker colgado con
# una transacción abierta retenga sus locks durante horas. 0 = usar el del servidor.
# DB_WAIT_TIMEOUT=300

# --- Almacenamiento (StorageService) ---
# Un VPS / NFS:
STORAGE_DRIVER=local
# STORAGE_PUBLIC_ROOT=/var/www/savid/public/uploads
# STORAGE_PRIVATE_ROOT=/var/www/savid/storage

# Varios VPS con object storage (MinIO, S3, Spaces, B2):
# STORAGE_DRIVER=s3
# S3_BUCKET=savid-prod
# S3_REGION=sa-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=https://s3.sa-east-1.amazonaws.com
# S3_PUBLIC_BASE_URL=https://cdn.tudominio.com/uploads
# S3_USE_PATH_STYLE=false

# --- Sesiones (varios VPS detrás de balanceador) ---
# Un VPS:
SESSION_DRIVER=files
# Varios VPS (requiere php-redis y servidor Redis):
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SESSION_DB=0
# REDIS_SESSION_PREFIX=savid:sess:
# SESSION_LIFETIME=86400
# SESSION_COOKIE_SECURE=true

# --- Bloqueos cron / tareas únicas ---
LOCK_DRIVER=file
# LOCK_FILE_DIR=/var/www/savid/storage/locks
# Varios VPS:
# LOCK_DRIVER=redis
# REDIS_LOCK_DB=1
# REDIS_LOCK_PREFIX=savid:lock:

# --- Producción ---
# APP_ENV=production
# display_errors se controla en public/index.php según APP_ENV

# --- Correo saliente (MailerService: recuperación de contraseña, etc.) ---
# APP_URL=https://tudominio.com
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=tls
# SMTP_FROM_EMAIL=no-responder@tudominio.com
# SMTP_FROM_NAME=SAVID

# --- Módulo SIHOS (conexión por empresa, ver tabla sihos_empresa_config) ---
# SOLO LECTURA: SIHOS es la BD de producción del hospital. El usuario de BD
# que se configure por empresa (pantalla "Conexión SIHOS") debe tener
# permisos de solo lectura (GRANT SELECT) en el servidor de SIHOS —
# SihosExternalRepository nunca debe escribir ahí.
# Clave para cifrar/descifrar la contraseña guardada por empresa
# (generar con: openssl rand -base64 32):
# SIHOS_CONFIG_KEY=
